EventScript_ResetAllBerries::
	@ Wondrous
	setberrytree BERRY_TREE_WONDROUS_ORAN_1,  BERRY_ID_ORAN,  BERRY_STAGE_BERRIES
	setberrytree BERRY_TREE_WONDROUS_ORAN_2,  BERRY_ID_ORAN,  BERRY_STAGE_BERRIES
	@ Record
	setberrytree BERRY_TREE_RECORD_TOWN_RAWST,  BERRY_ID_RAWST,  BERRY_STAGE_BERRIES
	setberrytree BERRY_TREE_RECORD_TOWN_CHERI,  BERRY_ID_CHERI,  BERRY_STAGE_BERRIES
	@ Reflecting
	setberrytree BERRY_TREE_REFLECTING_CITY_PECHA,  BERRY_ID_PECHA,  BERRY_STAGE_BERRIES
	setberrytree BERRY_TREE_REFLECTING_CITY_CHESTO,  BERRY_ID_CHESTO,  BERRY_STAGE_BERRIES
	@Route 2
	setberrytree BERRY_TREE_ROUTE_2_PERSIM,  BERRY_ID_PERSIM,  BERRY_STAGE_BERRIES
	setberrytree BERRY_TREE_ROUTE_2_ASPEAR,  BERRY_ID_ASPEAR,  BERRY_STAGE_BERRIES

	return

EventScript_ResetAllMapFlags::
	setflag FLAG_HIDE_CONTEST_POKE_BALL
	setflag FLAG_HIDE_BATTLE_TOWER_OPPONENT
	call EventScript_ResetAllBerries
	end

EventScript_ResetAllMapFlagsFrlg::
	end
