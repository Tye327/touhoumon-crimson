EventScript_ResetAllBerries::
	@ Wondrous
	setberrytree BERRY_TREE_WONDROUS_ORAN_1,  ITEM_TO_BERRY(ITEM_ORAN_BERRY),  BERRY_STAGE_BERRIES
	setberrytree BERRY_TREE_WONDROUS_ORAN_2,  ITEM_TO_BERRY(ITEM_ORAN_BERRY),  BERRY_STAGE_BERRIES
	@ Record
	setberrytree BERRY_TREE_RECORD_TOWN_RAWST,  ITEM_TO_BERRY(ITEM_RAWST_BERRY),  BERRY_STAGE_BERRIES
	setberrytree BERRY_TREE_RECORD_TOWN_CHERI,  ITEM_TO_BERRY(ITEM_CHERI_BERRY),  BERRY_STAGE_BERRIES
	@ Reflecting
	setberrytree BERRY_TREE_REFLECTING_CITY_PECHA,  ITEM_TO_BERRY(ITEM_PECHA_BERRY),  BERRY_STAGE_BERRIES
	setberrytree BERRY_TREE_REFLECTING_CITY_CHESTO,  ITEM_TO_BERRY(ITEM_CHESTO_BERRY),  BERRY_STAGE_BERRIES
	@Route 2
	setberrytree BERRY_TREE_ROUTE_2_PERSIM,  ITEM_TO_BERRY(ITEM_PERSIM_BERRY),  BERRY_STAGE_BERRIES
	setberrytree BERRY_TREE_ROUTE_2_ASPEAR,  ITEM_TO_BERRY(ITEM_ASPEAR_BERRY),  BERRY_STAGE_BERRIES

	return

EventScript_ResetAllMapFlags::
	setflag FLAG_HIDE_CONTEST_POKE_BALL
	setflag FLAG_HIDE_BATTLE_TOWER_OPPONENT
	call EventScript_ResetAllBerries
	end

EventScript_ResetAllMapFlagsFrlg::
	end
